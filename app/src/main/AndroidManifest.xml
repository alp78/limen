<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Address text is sent to swisstopo only while the person asks for a suggestion. The
         selected address and every handover record remain in private app storage. Photos come
         from the SYSTEM camera app through the provider grant below, so no camera permission is
         needed.

         Not even VIBRATE: the keys are felt through the window's own haptic feedback,
         which needs no permission. Holding VIBRATE was tried and measured on 2026-07-31
         and bought nothing, because the system drops any tap-length vibration from any API
         while the phone's touch feedback switch is off. -->

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Limen">
        <!-- Rotation is handled rather than survived. Compose keeps its state across a
             configuration change declared here, and without it the activity is recreated: the
             backup password box emptied, and every half-typed room, key and object name held in
             a plain remember was lost. The system dark schedule, a font or display size change
             and a keyboard attached to the tablet are declared for the same reason, since they
             arrive mid-handover. The language is left out on purpose: the relaunch is how the
             activity picks it up, and the signature pad keeps its ink through that. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|fontScale|density"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- One outward job: the system camera writes defect photos into this app's
             private cache through this grant. The finished PDF goes out through
             MediaStore.Downloads instead and needs no provider. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
